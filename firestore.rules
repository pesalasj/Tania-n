rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: conversations
    // Document ID: auto-generated
    // Fields:
    //   - userId: string (required) - The UID of the owner
    //   - createdAt: timestamp (required) - Creation time
    //   - transcript: list (required) - Array of strings
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['userId', 'createdAt', 'transcript']) &&
             data.userId is string &&
             data.createdAt is timestamp &&
             data.transcript is list &&
             data.transcript.size() <= 1000;
    }

    function isValidReminder(data) {
      return data.keys().hasAll(['userId', 'id', 'condition', 'status', 'createdAt']) &&
             data.userId is string &&
             data.id is string &&
             data.id.size() <= 128 &&
             data.condition is string &&
             data.condition.size() <= 1000 &&
             data.status is string &&
             (data.status == 'active' || data.status == 'met') &&
             data.createdAt is string &&
             data.createdAt.size() <= 64;
    }

    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid &&
                      isValidConversation(request.resource.data);
      allow update: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid &&
                      request.resource.data.userId == resource.data.userId &&
                      isValidConversation(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /reminders/{reminderId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid &&
                      isValidReminder(request.resource.data);
      allow update: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid &&
                      request.resource.data.userId == resource.data.userId &&
                      isValidReminder(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
